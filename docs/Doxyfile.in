PROJECT_NAME           = spatia
PROJECT_BRIEF          = "Strongly typed geometry and coordinate transformations"
OUTPUT_DIRECTORY       = @SPATIA_DOXYGEN_OUTPUT@
INPUT                  = @SPATIA_INCLUDE_DIR@/spatia/config.hpp \
                         @SPATIA_INCLUDE_DIR@/spatia/algebra \
                         @SPATIA_INCLUDE_DIR@/spatia/geometry \
                         @SPATIA_INCLUDE_DIR@/spatia/transforms
STRIP_FROM_PATH        = @SPATIA_INCLUDE_DIR@
FILE_PATTERNS          = *.hpp
RECURSIVE              = YES
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = YES
CPP_CLI_SUPPORT        = NO
CLANG_ASSISTED_PARSING = NO
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml
